rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTimestamp(val) {
      return val is timestamp || val is string;
    }

    // --- AnalysisRecord rules ---
    function isValidAnalysis(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'lncRnaName', 'interactionType', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'lncRnaName', 'lncRnaSequence', 'interactionType', 'targetName', 'score', 'summary', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.userId == request.auth.uid &&
        data.title is string && data.title.size() <= 200 &&
        data.lncRnaName is string && data.lncRnaName.size() <= 120 &&
        data.interactionType is string && data.interactionType.size() <= 50 &&
        (!('lncRnaSequence' in data) || (data.lncRnaSequence is string && data.lncRnaSequence.size() <= 10000)) &&
        (!('targetName' in data) || (data.targetName is string && data.targetName.size() <= 120)) &&
        (!('score' in data) || data.score is number) &&
        (!('summary' in data) || (data.summary is string && data.summary.size() <= 2000));
    }

    match /analyses/{analysisId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(analysisId) &&
        isValidAnalysis(request.resource.data) &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        isValidId(analysisId) &&
        isValidAnalysis(request.resource.data) &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() &&
        isValidId(analysisId) &&
        resource.data.userId == request.auth.uid;
    }

    // --- Bookmark rules ---
    function isValidBookmark(data) {
      return data.keys().hasAll(['id', 'userId', 'lncRnaId', 'lncRnaName', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'lncRnaId', 'lncRnaName', 'species', 'notes', 'createdAt']) &&
        isValidId(data.id) &&
        data.userId == request.auth.uid &&
        isValidId(data.lncRnaId) &&
        data.lncRnaName is string && data.lncRnaName.size() <= 120 &&
        (!('species' in data) || (data.species is string && data.species.size() <= 120)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    match /bookmarks/{bookmarkId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(bookmarkId) &&
        isValidBookmark(request.resource.data) &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        isValidId(bookmarkId) &&
        isValidBookmark(request.resource.data) &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() &&
        isValidId(bookmarkId) &&
        resource.data.userId == request.auth.uid;
    }

    // --- UserProfile rules ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'email', 'displayName', 'affiliation', 'role', 'createdAt', 'updatedAt']) &&
        data.userId == request.auth.uid &&
        data.email is string && data.email.size() <= 200 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150)) &&
        (!('affiliation' in data) || (data.affiliation is string && data.affiliation.size() <= 200)) &&
        (!('role' in data) || (data.role is string && data.role.size() <= 50));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfile(request.resource.data);
      allow update: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        resource.data.userId == request.auth.uid &&
        isValidUserProfile(request.resource.data) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId;
    }
  }
}
