{
  "entities": {
    "AnalysisRecord": {
      "title": "AnalysisRecord",
      "description": "A saved lncRNA computational interaction or homology screening record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "lncRnaName": { "type": "string", "maxLength": 120 },
        "lncRnaSequence": { "type": "string", "maxLength": 10000 },
        "interactionType": { "type": "string", "maxLength": 50 },
        "targetName": { "type": "string", "maxLength": 120 },
        "score": { "type": "number" },
        "summary": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "lncRnaName", "interactionType", "createdAt"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "Bookmarked lncRNA entry from the curated database",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "lncRnaId": { "type": "string", "maxLength": 128 },
        "lncRnaName": { "type": "string", "maxLength": 120 },
        "species": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "lncRnaId", "lncRnaName", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 150 },
        "affiliation": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "createdAt"]
    }
  },
  "firestore": {
    "/analyses/{analysisId}": {
      "schema": "AnalysisRecord",
      "description": "User-run computational screenings and predictions"
    },
    "/bookmarks/{bookmarkId}": {
      "schema": "Bookmark",
      "description": "User bookmarks of lncRNAs"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    }
  }
}
